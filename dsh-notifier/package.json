{
  "name": "@local/dsh-notifier",
  "version": "0.2.0",
  "description": "Cross-platform desktop and webhook notifications for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=index.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}

{
  "name": "@local/my-dsh-plugins",
  "version": "0.5.0",
  "description": "Umbrella bundle loader and configuration manager for local DSH plugins",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "workspaces": [
    "dsh-*"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('index.js',{force:true}); fs.rmSync('dsh-notifier/index.js',{force:true})\"",
    "build:self": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=index.js",
    "build:plugins": "npm run build --workspaces",
    "build": "npm run build:plugins && npm run build:self",
    "test": "npm test --workspaces && node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
